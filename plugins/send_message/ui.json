{
  "type": "message",
  "name": "Сообщение",
  "icon": "💬",
  "color": "#2563eb",
  "description": "Отправка текста, медиа и inline-кнопок пользователю",
  "palette": true,
  "connectable": true,
  "outputs": "dynamic",
  "defaults": {
    "text": "Сообщение",
    "media": {
      "type": null,
      "files": []
    },
    "inlineButtons": [],
    "inlineButtonRowBreaks": [
      0
    ],
    "disableWebPagePreview": false,
    "tagId": ""
  },
  "fields": [
    {
      "key": "tagId",
      "type": "tag_select",
      "label": "Тэг",
      "hint": "Быстрая ссылка на переход в блок с выбранным тэгом"
    },
    {
      "key": "media",
      "type": "media",
      "label": "Медиа",
      "hint": "Изображение, видео, аудио или документы"
    },
    {
      "key": "text",
      "type": "textarea",
      "label": "Сообщение",
      "hint": "Текст сообщения. Ссылки, {{поле}} для данных из БД",
      "maxLength": 10000,
      "placeholder": "Текст сообщения"
    },
    {
      "key": "disableWebPagePreview",
      "type": "checkbox",
      "label": "Скрыть предпросмотр ссылок"
    },
    {
      "key": "inlineButtons",
      "type": "inline_buttons",
      "label": "Inline-кнопки",
      "hint": "Перетаскивайте: на кнопку — замена мест; в зону ряда — перенос"
    }
  ],
  "ai_capabilities": {
    "summary": "Отправляет пользователю текст, медиа и/или inline-кнопки.",
    "can": [
      "текст с {{полями}}",
      "медиа",
      "inline-кнопки и ветки по ним"
    ],
    "cannot": [
      "сохранять ответы в БД",
      "ветвление по полям без кнопок",
      "внешний HTTP"
    ],
    "when_to_use": "Любой ответ бота пользователю, FAQ-тексты, кнопки-ссылки.",
    "data_shape_hint": "text, media{type,files}, inlineButtons[], disableWebPagePreview"
  }
}
