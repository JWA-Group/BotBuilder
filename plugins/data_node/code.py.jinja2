{# Handler for block type: data #}
async def _type_handler_data(bot, chat_id, user_id, block_id, ctx, data, disable):
    action = data.get("action", "set")
    if action == "issue":
        product_id = resolve_text(str(data.get("productId") or "").strip(), user_id)
        content = issue_inventory_item(product_id, user_id)
        out_idx = 0 if content is not None else 1
        next_id = get_next_block(block_id, out_idx)
        if next_id:
            return await execute_block(bot, chat_id, user_id, next_id, ctx)
        return await handle_unwired_port(bot, chat_id, user_id, block_id, out_idx, ctx)
    raw_field = (data.get("fieldName") or "").strip()
    field_type = data.get("fieldType", "string")
    scope, _ = _parse_placeholder_key(raw_field) if raw_field else ("legacy", "")
    is_bot_scope = scope == "bot" or raw_field.lower().startswith("bot.")
    field = (
        raw_field
        if scope == "table"
        else (_normalize_bot_key(raw_field) if is_bot_scope else _normalize_user_field(raw_field))
    )
    if not field:
        next_id = get_next_block(block_id, 0)
        if next_id:
            return await execute_block(bot, chat_id, user_id, next_id, ctx)
        return
    if action == "set":
        src = data.get("valueSource", "const")
        if src == "input":
            next_id = get_next_block(block_id, 0)
            # Track visits in this synchronous tick. A loop back to the same
            # Input node (e.g. failed condition) MUST re-await a NEW message —
            # never skip and never consume the trigger/previous tick text.
            visits = ctx.setdefault("_tick_input_visits", [])
            reentry = block_id in visits
            visits.append(block_id)

            # Skip-if-filled only on cold graph entry (button/start), never when
            # continuing after an FSM wait (accept_input) or on same-tick reentry.
            # Otherwise validation loops lose FSM and fall through to /start.
            allow_skip = (
                bool(data.get("inputOnlyIfEmpty", True))
                and not reentry
                and not ctx.get("accept_input")
            )
            if allow_skip:
                existing = resolve_field_value(user_id, raw_field)
                if existing is not None and str(existing).strip() != "":
                    if next_id:
                        return await execute_block(bot, chat_id, user_id, next_id, ctx)
                    return
            # ALWAYS pause for a fresh user event. Do not read last_message_text
            # here — button labels / prior tick values must not auto-fill.
            # If a Message already sent a prompt in this tick, skip Data's prompt.
            return (
                "await_input",
                {
                    "block_id": block_id,
                    "field": raw_field,
                    "field_type": field_type,
                    "next_id": next_id,
                    "skip_prompt": bool(ctx.get("_tick_message_sent")),
                },
            )
        if src == "current_datetime":
            val = _msk_now_str()
        else:
            raw_val = data.get("fieldValue")
            if raw_val is None:
                raw_val = ""
            val = resolve_text(str(raw_val), user_id)
        if field_type == "number":
            try:
                val = str(float(str(val).replace(",", ".")))
            except (ValueError, TypeError):
                val = "0"
        elif field_type in ("date", "time", "datetime"):
            val = normalize_temporal_value(val, field_type)
        apply_scoped_field_value(user_id, raw_field, val)
    elif action == "add":
        cur = resolve_field_value(user_id, raw_field)
        try:
            cur_f = float(str(cur or "0").replace(",", "."))
        except (ValueError, TypeError):
            cur_f = 0
        delta_raw = data.get("fieldValue") or "0"
        delta = resolve_text(str(delta_raw), user_id)
        try:
            delta_f = float(str(delta).replace(",", "."))
        except (ValueError, TypeError):
            delta_f = 0
        new_val = str(cur_f + delta_f)
        apply_scoped_field_value(user_id, raw_field, new_val)
    elif action == "subtract":
        cur = resolve_field_value(user_id, raw_field)
        try:
            cur_f = float(str(cur or "0").replace(",", "."))
        except (ValueError, TypeError):
            cur_f = 0
        delta_raw = data.get("fieldValue") or "0"
        delta = resolve_text(str(delta_raw), user_id)
        try:
            delta_f = float(str(delta).replace(",", "."))
        except (ValueError, TypeError):
            delta_f = 0
        new_val = str(cur_f - delta_f)
        apply_scoped_field_value(user_id, raw_field, new_val)
    next_id = get_next_block(block_id, 0)
    if next_id:
        return await execute_block(bot, chat_id, user_id, next_id, ctx)
